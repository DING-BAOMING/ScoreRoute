# ============================================
# ScoreRoute 环境配置
# ============================================
# 
# 使用说明:
# 1. 复制此文件: cp .env.example .env
# 2. 修改以下必填项:
#    - ADMIN_PASSWORD: 设置强密码 (至少8位)
#    - JWT_SECRET: 运行以下命令生成: openssl rand -base64 32
# 3. 启动服务: docker-compose up -d
#

# 服务器配置
PORT=3000
DATABASE_PATH=./data/gateway.db
LOG_PATH=./logs

# --------------------------------------------
# 必填配置 (必须修改)
# --------------------------------------------

# 管理员密码
# 提示: 使用强密码，建议包含大小写字母、数字和特殊字符
ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT签名密钥
# 提示: 运行以下命令生成随机密钥:
# openssl rand -base64 32
JWT_SECRET=GENERATE_WITH_OPENSSL_COMMAND

# --------------------------------------------
# CORS 配置 (可选)
# --------------------------------------------

# CORS允许的源列表，多个用逗号分隔
# 示例: https://example.com,https://app.example.com
# 设置为 * 允许所有源 (注意: 不能与 credentials 同时使用)
# CORS_ALLOWED_ORIGINS=https://example.com

# --------------------------------------------
# 可选配置
# --------------------------------------------

# 调度模式: polling 或 smart
# POLLING_MODE=polling

# 密码less模式: true 或 false (生产环境建议false)
# PASSWORD_LESS_MODE=false
